{
  "name": "stories-of-islam",
  "version": "0.1.0",
  "private": true,
  "description": "Islamic Stories Repository — API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:migrate:prod": "node dist/cli/migrate.js",
    "db:seed": "tsx src/cli/seed.ts",
    "db:seed:prod": "node dist/cli/seed.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm --prefix mobile run check",
    "platform:local": "bash scripts/bringup-local-hostafrica.sh",
    "platform:validate": "bash infra/hostafrica/scripts/validate-stack.sh",
    "acceptance:staging": "bash scripts/staging-acceptance.sh",
    "go-live": "bash scripts/go-live.sh",
    "go-live:preflight": "bash scripts/go-live-preflight.sh",
    "go-live:local": "bash scripts/go-live.sh all-local",
    "go-live:hostafrica": "bash scripts/hostafrica-apply-on-server.sh",
    "assert:no-example-cdn": "bash scripts/assert-no-example-cdn.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
