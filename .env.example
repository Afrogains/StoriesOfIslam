# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

# WhoGoHost PostgreSQL (use sslmode=require outside local Docker)
DATABASE_URL=postgresql://stories_app:change-me@localhost:5432/stories_of_islam
DATABASE_SSL=false
DB_POOL_MAX=10

# Keycloak / OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/stories-of-islam
KEYCLOAK_AUDIENCE=stories-api
KEYCLOAK_ADMIN_CLIENT_ID=stories-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=stories-api
S3_SECRET_KEY=change-me
S3_PUBLIC_BUCKET=stories-public
S3_PRIVATE_BUCKET=stories-private
S3_PUBLIC_BASE_URL=http://localhost:9000/stories-public
S3_FORCE_PATH_STYLE=true

# AI and voice synthesis (server/worker only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_HOST_A=
ELEVENLABS_VOICE_HOST_B=
GOOGLE_TTS_API_KEY=
FFMPEG_PATH=ffmpeg

# Worker controls
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1

# Monitoring
SENTRY_DSN=
RELEASE_SHA=local
METRICS_TOKEN=change-me
