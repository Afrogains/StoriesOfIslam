{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_API_URL": "${EXPO_PUBLIC_API_URL}",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "${EXPO_PUBLIC_KEYCLOAK_ISSUER}",
        "EXPO_PUBLIC_KEYCLOAK_MOBILE_CLIENT_ID": "${EXPO_PUBLIC_KEYCLOAK_MOBILE_CLIENT_ID}",
        "EXPO_PUBLIC_KEYCLOAK_WEB_CLIENT_ID": "${EXPO_PUBLIC_KEYCLOAK_WEB_CLIENT_ID}",
        "EXPO_PUBLIC_SENTRY_DSN": "${EXPO_PUBLIC_SENTRY_DSN}"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_API_URL": "${EXPO_PUBLIC_API_URL}",
        "EXPO_PUBLIC_KEYCLOAK_ISSUER": "${EXPO_PUBLIC_KEYCLOAK_ISSUER}",
        "EXPO_PUBLIC_KEYCLOAK_MOBILE_CLIENT_ID": "${EXPO_PUBLIC_KEYCLOAK_MOBILE_CLIENT_ID}",
        "EXPO_PUBLIC_KEYCLOAK_WEB_CLIENT_ID": "${EXPO_PUBLIC_KEYCLOAK_WEB_CLIENT_ID}",
        "EXPO_PUBLIC_SENTRY_DSN": "${EXPO_PUBLIC_SENTRY_DSN}"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "${ASC_APP_ID}"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
