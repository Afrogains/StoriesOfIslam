    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@tanstack/react-query": "^5.102.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo": "^57.0.23",
    "expo-asset": "~57.0.17",
