# Copy to /etc/stories/api.env on the API host. Never commit real secrets.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true

DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=/var/lib/mysql/mysql.sock
DB_NAME=afroclov_StoriesOfIslam
DB_USER=afroclov_StoriesOfIslam
DB_PASSWORD=
DB_POOL_MAX=20
DATABASE_SSL=false

KEYCLOAK_ISSUER=https://auth.example.com/realms/stories-of-islam
KEYCLOAK_AUDIENCE=stories-api
KEYCLOAK_ADMIN_CLIENT_ID=stories-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

S3_ENDPOINT=https://media.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=stories-api
S3_SECRET_KEY=change-me
S3_PUBLIC_BUCKET=stories-public
S3_PRIVATE_BUCKET=stories-private
S3_PUBLIC_BASE_URL=https://media.example.com/stories-public
S3_FORCE_PATH_STYLE=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_HOST_A=
ELEVENLABS_VOICE_HOST_B=
GOOGLE_TTS_API_KEY=
FFMPEG_PATH=ffmpeg

WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1
MAX_GENERATION_JOBS_PER_USER_PER_DAY=10

SENTRY_DSN=
RELEASE_SHA=replace-with-git-sha
METRICS_TOKEN=change-me
